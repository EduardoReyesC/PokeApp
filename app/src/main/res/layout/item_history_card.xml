<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    android:layout_marginHorizontal="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Versus y Participantes -->
            <TextView
                android:id="@+id/tvMatchup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bulbasaur VS Pikachu"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Indicador Ganador -->
            <TextView
                android:id="@+id/tvWinnerBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#DCFCE7"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="Ganó: Bulbasaur"
                android:textColor="#16A34A"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Fecha del Combate -->
        <TextView
            android:id="@+id/tvBattleDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="07/10/2026 - 15:30"
            android:textColor="#64748B"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Toca para ver el desglose de turnos..."
            android:textColor="#0284C7"
            android:textSize="11sp"
            android:textStyle="italic" />

    </LinearLayout>
</androidx.cardview.widget.CardView>