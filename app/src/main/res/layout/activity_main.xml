<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- 1. Barra de Búsqueda y Acciones Rápidas -->
    <LinearLayout
        android:id="@+id/topBarBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <EditText
            android:id="@+id/etPokemon"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="Nombre o ID..."
            android:inputType="text"
            android:paddingHorizontal="10dp"
            android:textColor="@android:color/black"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnConsultar"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:text="Buscar" />

        <ImageButton
            android:id="@+id/btnPlayCry"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Audio Cry"
            android:src="@android:drawable/ic_lock_silent_mode_off"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btnFavorite"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Favorito"
            android:src="@android:drawable/star_big_off" />
    </LinearLayout>

    <!-- 2. Tarjeta Superior con Layout Porcentual Puro -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardPokemonHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="2dp"
        app:cardBackgroundColor="#1E293B"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:layout_constraintTop_toBottomOf="@id/topBarBox">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="10dp"
            android:paddingHorizontal="4dp">

            <!-- Badge Número Base de la Pokédex -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardBaseNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                app:cardCornerRadius="6dp"
                app:cardBackgroundColor="#0F172A"
                app:cardElevation="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <TextView
                    android:id="@+id/txtBaseNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#0001"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp" />
            </androidx.cardview.widget.CardView>

            <!-- Flecha Anterior -->
            <ImageButton
                android:id="@+id/btnPrevPokemon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_previous"
                app:tint="#FBBF24"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/imgPokemon"
                app:layout_constraintBottom_toBottomOf="@+id/imgPokemon" />

            <!-- Sprite Pokémon (40% del ancho de pantalla) -->
            <ImageView
                android:id="@+id/imgPokemon"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_marginTop="2dp"
                android:scaleType="fitCenter"
                android:padding="2dp"
                android:contentDescription="Sprite del Pokémon"
                app:layout_constraintWidth_percent="0.40"
                app:layout_constraintStart_toEndOf="@id/btnPrevPokemon"
                app:layout_constraintTop_toBottomOf="@id/cardBaseNumber" />

            <!-- Radar de Estadísticas (50% del ancho de pantalla) -->
            <com.example.pokeappicesba.RadarStatsView
                android:id="@+id/headerRadarStats"
                android:layout_width="0dp"
                android:layout_height="140dp"
                app:layout_constraintWidth_percent="0.50"
                app:layout_constraintStart_toEndOf="@id/imgPokemon"
                app:layout_constraintEnd_toStartOf="@id/btnNextPokemon"
                app:layout_constraintTop_toTopOf="@id/imgPokemon"
                app:layout_constraintBottom_toBottomOf="@id/imgPokemon" />

            <!-- Flecha Siguiente -->
            <ImageButton
                android:id="@+id/btnNextPokemon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_next"
                app:tint="#FBBF24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/imgPokemon"
                app:layout_constraintBottom_toBottomOf="@+id/imgPokemon" />

            <!-- Nombre y Número Centrado -->
            <TextView
                android:id="@+id/txtHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0001 BULBASAUR"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imgPokemon" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- 3. Pestañas Deslizantes -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/dexTabLayout"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="6dp"
        android:background="#0F172A"
        app:tabIndicatorColor="#38BDF8"
        app:tabIndicatorHeight="3dp"
        app:tabSelectedTextColor="#38BDF8"
        app:tabTextColor="#94A3B8"
        app:tabMode="fixed"
        app:layout_constraintTop_toBottomOf="@id/cardPokemonHeader" />

    <!-- 4. ViewPager2 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/dexViewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#0F172A"
        app:layout_constraintTop_toBottomOf="@id/dexTabLayout"
        app:layout_constraintBottom_toTopOf="@id/cardEvolution" />

    <!-- 5. Tarjeta de Línea Evolutiva Fija -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardEvolution"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="50dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="#1E293B"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LÍNEA EVOLUTIVA"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/evolutionContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />
            </HorizontalScrollView>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 6. Botón circular flotante inferior -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btnBottomHome"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginBottom="6dp"
        app:cardCornerRadius="21dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#1E293B"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#EF4444"
            android:contentDescription="Regresar al Menú" />
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>