<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- 1. Barra de Búsqueda y Botones Superiores -->
    <LinearLayout
        android:id="@+id/topBarBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <EditText
            android:id="@+id/etPokemon"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="Nombre o ID..."
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:textColor="@android:color/black"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnConsultar"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:text="Buscar" />

        <ImageButton
            android:id="@+id/btnPlayCry"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Escuchar Cry"
            android:src="@android:drawable/ic_lock_silent_mode_off"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btnFavorite"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Favorito"
            android:src="@android:drawable/star_big_off" />
    </LinearLayout>

    <!-- 2. Tarjeta Superior de Presentación -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardPokemonHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        app:cardBackgroundColor="#1E293B"
        app:cardCornerRadius="18dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/topBarBox">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:paddingHorizontal="8dp">

            <ImageButton
                android:id="@+id/btnPrevPokemon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Anterior Pokémon"
                android:src="@android:drawable/ic_media_previous"
                app:tint="#FBBF24"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/imgPokemon"
                app:layout_constraintBottom_toBottomOf="@+id/imgPokemon" />

            <ImageView
                android:id="@+id/imgPokemon"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:contentDescription="Sprite del Pokémon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnPrevPokemon"
                app:layout_constraintEnd_toStartOf="@+id/btnNextPokemon" />

            <ImageButton
                android:id="@+id/btnNextPokemon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Siguiente Pokémon"
                android:src="@android:drawable/ic_media_next"
                app:tint="#FBBF24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/imgPokemon"
                app:layout_constraintBottom_toBottomOf="@+id/imgPokemon" />

            <TextView
                android:id="@+id/txtHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0001 BULBASAUR"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp"
                app:layout_constraintTop_toBottomOf="@id/imgPokemon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/txtTiposTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#0F172A"
                android:paddingHorizontal="14dp"
                android:paddingVertical="4dp"
                android:text="PLANTA / VENENO"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/txtHeaderTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- 3. Pestañas Deslizantes -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/dexTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#0F172A"
        app:tabIndicatorColor="#38BDF8"
        app:tabIndicatorHeight="3dp"
        app:tabSelectedTextColor="#38BDF8"
        app:tabTextColor="#94A3B8"
        app:tabMode="fixed"
        app:layout_constraintTop_toBottomOf="@id/cardPokemonHeader" />

    <!-- 4. Contenedor ViewPager2 (dejamos 60dp de margen inferior para no tapar contenido) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/dexViewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#0F172A"
        android:paddingBottom="60dp"
        app:layout_constraintTop_toBottomOf="@id/dexTabLayout"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- 5. Botón circular flotante estilo Pokémon GO (abajo al centro) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btnBottomHome"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="26dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#1E293B"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Regresar al Menú Principal"
            app:tint="#EF4444" />
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>