<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A">

    <!-- Pestañas superiores estilo Pokémon HOME -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F172A"
        app:tabIndicatorColor="#38BDF8"
        app:tabIndicatorHeight="3dp"
        app:tabSelectedTextColor="#38BDF8"
        app:tabTextColor="#94A3B8"
        app:tabMode="fixed" />

    <!-- Barra de perfil de Entrenador (Estilo Pokémon HOME) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="8dp"
        android:padding="8dp"
        android:background="#1E293B">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@mipmap/ic_launcher_round" />

        <TextView
            android:id="@+id/tvTrainerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Entrenador"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnQuickLogout"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Salir"
            android:textColor="#EF4444"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Contenedor deslizable de las vistas -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerHome"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>