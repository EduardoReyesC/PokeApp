<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Descripción / Comportamiento -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cargando información del Pokémon..."
            android:textColor="#E2E8F0"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:background="#164E63"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Altura: -- | Peso: --"
            android:textColor="#A5F3FC"
            android:textSize="13sp"
            android:layout_marginBottom="10dp" />

        <!-- Radar Hexagonal de Stats -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Distribución de Estadísticas"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <com.example.pokeappicesba.RadarStatsView
            android:id="@+id/radarStats"
            android:layout_width="match_parent"
            android:layout_height="220dp" />
    </LinearLayout>
</ScrollView>