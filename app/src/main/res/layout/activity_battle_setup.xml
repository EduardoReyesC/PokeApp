<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DC2626">

    <!-- Marco Biselado de Consola -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        app:cardBackgroundColor="#CBD5E1"
        app:cardCornerRadius="18dp"
        app:cardElevation="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:layout_margin="4dp"
            android:padding="20dp"
            android:gravity="center">

            <!-- Título -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONFIGURAR COMBATE"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- SECCIÓN JUGADOR -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tu Pokémon (Nombre o ID)"
                android:textColor="#0284C7"
                android:textStyle="bold"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/etSetupPlayer"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@android:drawable/editbox_background_normal"
                    android:hint="Ej. 1 o bulbasaur"
                    android:textColorHint="#94A3B8"
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:paddingHorizontal="12dp" />

                <ImageButton
                    android:id="@+id/btnRandomPlayer"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#F59E0B"
                    android:src="@android:drawable/ic_menu_help"
                    app:tint="@android:color/white"
                    android:contentDescription="Aleatorio Jugador" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VS"
                android:textColor="#EF4444"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginVertical="6dp" />

            <!-- SECCIÓN RIVAL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pokémon Rival (Nombre o ID)"
                android:textColor="#DC2626"
                android:textStyle="bold"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp">

                <EditText
                    android:id="@+id/etSetupRival"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@android:drawable/editbox_background_normal"
                    android:hint="Ej. 25 o pikachu"
                    android:textColorHint="#94A3B8"
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:paddingHorizontal="12dp" />

                <ImageButton
                    android:id="@+id/btnRandomRival"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#F59E0B"
                    android:src="@android:drawable/ic_menu_help"
                    app:tint="@android:color/white"
                    android:contentDescription="Aleatorio Rival" />
            </LinearLayout>

            <!-- Botones de Acción -->
            <Button
                android:id="@+id/btnStartBattle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="#0284C7"
                android:text="¡A LUCHAR!"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCancelSetup"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:background="@android:color/transparent"
                android:text="Cancelar"
                android:textColor="#64748B"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>