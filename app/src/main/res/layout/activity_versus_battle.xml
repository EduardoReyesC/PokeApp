<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E2E8F0">

    <!-- ARENA SUPERIOR (Rival) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/arenaOpponent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:layout_constraintHeight_percent="0.35"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/fondo" />

        <LinearLayout android:layout_width="180dp" android:layout_height="wrap_content" android:orientation="vertical" android:background="#CCFFFFFF" android:padding="8dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" android:layout_margin="16dp">
            <TextView android:id="@+id/tvOpponentName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rival PKMN" android:textStyle="bold" android:textColor="#000000" />
            <ProgressBar android:id="@+id/pbOpponentHp" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="12dp" android:progressTint="#22C55E" android:max="100" android:progress="100" />
            <!-- Indicador 3v3 Rival -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
                <ImageView android:id="@+id/oppSlot1" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/icono" />
                <ImageView android:id="@+id/oppSlot2" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/icono" android:layout_marginStart="4dp"/>
                <ImageView android:id="@+id/oppSlot3" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/icono" android:layout_marginStart="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <ImageView android:id="@+id/ivOpponentSprite" android:layout_width="140dp" android:layout_height="140dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginEnd="32dp" android:layout_marginBottom="16dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ARENA INFERIOR (Jugador Activo) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/arenaPlayer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.35"
        app:layout_constraintTop_toBottomOf="@id/arenaOpponent">

        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/fondo" />

        <LinearLayout android:layout_width="180dp" android:layout_height="wrap_content" android:orientation="vertical" android:background="#CCFFFFFF" android:padding="8dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_margin="16dp">
            <TextView android:id="@+id/tvPlayerName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tu PKMN" android:textStyle="bold" android:textColor="#000000" />
            <ProgressBar android:id="@+id/pbPlayerHp" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="12dp" android:progressTint="#22C55E" android:max="100" android:progress="100" />
            <!-- Indicador 3v3 Jugador -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
                <ImageView android:id="@+id/p1Slot1" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/icono" />
                <ImageView android:id="@+id/p1Slot2" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/icono" android:layout_marginStart="4dp"/>
                <ImageView android:id="@+id/p1Slot3" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/icono" android:layout_marginStart="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <ImageView android:id="@+id/ivPlayerSprite" android:layout_width="160dp" android:layout_height="160dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" android:layout_marginStart="32dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- PANEL DE CONTROL (Consola de comandos) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#1E293B"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/arenaPlayer"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView android:id="@+id/tvBattleLog" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#FFFFFF" android:padding="8dp" android:text="¿Qué hará tu Pokémon?" android:textColor="#000000" android:textSize="14sp" />

        <!-- Grid de los 4 Ataques -->
        <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:rowCount="2" android:layout_marginTop="8dp">
            <Button android:id="@+id/btnAtk1" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btnAtk2" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btnAtk3" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btnAtk4" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:textColor="#FFFFFF"/>
        </GridLayout>

        <!-- Botón de Cambio (Separado y ancho completo) -->
        <Button android:id="@+id/btnChangePkmn" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginHorizontal="4dp" android:text="CAMBIAR PKMN" android:backgroundTint="#16A34A" android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- PANTALLA CIEGA INTERSTICIAL -->
    <FrameLayout
        android:id="@+id/overlayBattleBlind"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0F172A"
        android:elevation="10dp"
        android:visibility="gone">

        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="24dp">
            <ImageView android:layout_width="100dp" android:layout_height="100dp" android:src="@drawable/icono" />
            <TextView android:id="@+id/tvBattleBlindMessage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Turno del Jugador 2\n(Pasa el dispositivo)" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" android:gravity="center" />
            <Button android:id="@+id/btnBattleReady" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="40dp" android:text="Ver mi equipo y atacar" android:backgroundTint="#DC2626" android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>