<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Buscador y Botón Ver Favoritos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/etPokemon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:drawable/editbox_background_normal"
                android:hint="Nombre o ID..."
                android:inputType="text"
                android:padding="10dp"
                android:textColor="@android:color/black" />

            <Button
                android:id="@+id/btnConsultar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buscar"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Botón para desplegar favoritos -->
        <Button
            android:id="@+id/btnVerFavoritos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⭐ Ver Favoritos Guardados"
            android:backgroundTint="#F59E0B"
            android:layout_marginBottom="12dp" />

        <!-- Ficha del Pokémon -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#1E293B"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"
                android:gravity="center_horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/txtIdPokemon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#---"
                        android:textColor="#94A3B8"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtNombrePokemon"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="POKÉMON"
                        android:textColor="@android:color/white"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginStart="12dp" />

                    <ImageButton
                        android:id="@+id/btnFavorite"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Favorito"
                        android:src="@android:drawable/star_big_off" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgPokemon"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center"
                    android:layout_marginVertical="6dp" />

                <Button
                    android:id="@+id/btnPlayCry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Escuchar Cry"
                    android:textSize="12sp"
                    android:backgroundTint="#3B82F6"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/txtTipos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tipo: --"
                    android:textColor="#38BDF8"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/txtMedidas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Altura: -- | Peso: --"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/txtHabilidades"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Habilidades: --"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Estadísticas -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#1E293B">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Estadísticas Base"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView android:id="@+id/txtHp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="HP: --" android:textColor="#F87171" android:layout_marginBottom="4dp" />
                <TextView android:id="@+id/txtAtaque" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ataque: --" android:textColor="#FBBF24" android:layout_marginBottom="4dp" />
                <TextView android:id="@+id/txtDefensa" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Defensa: --" android:textColor="#60A5FA" android:layout_marginBottom="4dp" />
                <TextView android:id="@+id/txtAtaqueEspecial" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Atq. Especial: --" android:textColor="#F472B6" android:layout_marginBottom="4dp" />
                <TextView android:id="@+id/txtDefensaEspecial" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Def. Especial: --" android:textColor="#818CF8" android:layout_marginBottom="4dp" />
                <TextView android:id="@+id/txtVelocidad" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Velocidad: --" android:textColor="#34D399" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>