<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DC2626">

    <!-- Bisel de Pantalla Superior (Estadio Claro) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="6dp"
        android:layout_marginVertical="6dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#CBD5E1">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F8FAFC"
            android:layout_margin="3dp">

            <!-- LÍNEA DIVISORIA: 55% Campo de Batalla, 45% Controles -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideLineHorizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.55" />

            <!-- Fondo ambiental del Campo de Batalla (55% Superior) -->
            <View
                android:id="@+id/battleFieldBackground"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="#F1F5F9"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/guideLineHorizontal" />

            <!-- Botón para regresar -->
            <ImageButton
                android:id="@+id/btnBackBattle"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#0F172A"
                android:contentDescription="Regresar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Botón oculto para repetir combate -->
            <Button
                android:id="@+id/btnReplayBattle"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#16A34A"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Repetir Combate"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- ========================================== -->
            <!-- CAMPO DE BATALLA (SUPERIOR)                -->
            <!-- ========================================== -->

            <!-- Info del Rival (Arriba a la izquierda) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/boxEnemyInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="10dp"
                app:cardElevation="3dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnBackBattle">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp">

                    <TextView
                        android:id="@+id/tvEnemyName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cargando..."
                        android:textColor="#0F172A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/pbEnemyHp"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="135dp"
                        android:layout_height="10dp"
                        android:layout_marginTop="4dp"
                        android:max="100"
                        android:progress="100"
                        android:progressTint="#16A34A" />

                    <TextView
                        android:id="@+id/tvEnemyHpPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:text="100%"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Sprite del Rival (Frente, Arriba a la derecha) -->
            <ImageView
                android:id="@+id/imgEnemySprite"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp"
                android:scaleType="fitCenter"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@android:drawable/ic_menu_gallery" />

            <!-- Sprite del Jugador (Espalda, Abajo a la izquierda) -->
            <ImageView
                android:id="@+id/imgPlayerSprite"
                android:layout_width="145dp"
                android:layout_height="145dp"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="10dp"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toTopOf="@id/boxBattleLog"
                app:layout_constraintStart_toStartOf="parent"
                tools:src="@android:drawable/ic_menu_gallery" />

            <!-- Info del Jugador (Abajo a la derecha) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/boxPlayerInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="10dp"
                app:cardElevation="3dp"
                app:layout_constraintBottom_toTopOf="@id/boxBattleLog"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp">

                    <TextView
                        android:id="@+id/tvPlayerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cargando..."
                        android:textColor="#0F172A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/pbPlayerHp"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="145dp"
                        android:layout_height="10dp"
                        android:layout_marginTop="4dp"
                        android:max="300"
                        android:progress="300"
                        android:progressTint="#16A34A" />

                    <TextView
                        android:id="@+id/tvPlayerHpExact"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:text="---/---"
                        android:textColor="#0284C7"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Caja de Texto del Combate (Battle Log) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/boxBattleLog"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginBottom="6dp"
                app:cardBackgroundColor="#E0F2FE"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:layout_constraintBottom_toTopOf="@id/guideLineHorizontal">

                <TextView
                    android:id="@+id/tvBattleLog"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:text="Conectando con el estadio..."
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>

            <!-- ========================================== -->
            <!-- CONTROLES DE BATALLA (INFERIOR 45%)        -->
            <!-- ========================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:paddingHorizontal="8dp"
                android:paddingTop="6dp"
                app:layout_constraintTop_toBottomOf="@id/guideLineHorizontal"
                app:layout_constraintBottom_toBottomOf="parent">

                <!-- Título Sección Ataque -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MOVIMIENTOS DISPONIBLES"
                    android:textColor="#DC2626"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="4dp" />

                <!-- Grid de 4 botones de ataque -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="2">

                    <!-- Ataque 1 -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/btnAttack1"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="3dp"
                        app:cardBackgroundColor="#F97316"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvAtk1Name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="---"
                                android:textColor="@android:color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvAtk1Info"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#F1F5F9"
                                android:textSize="9.5sp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Ataque 2 -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/btnAttack2"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="3dp"
                        app:cardBackgroundColor="#D97706"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvAtk2Name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="---"
                                android:textColor="@android:color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvAtk2Info"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#F1F5F9"
                                android:textSize="9.5sp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Ataque 3 -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/btnAttack3"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="3dp"
                        app:cardBackgroundColor="#0284C7"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvAtk3Name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="---"
                                android:textColor="@android:color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvAtk3Info"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#F1F5F9"
                                android:textSize="9.5sp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Ataque 4 -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/btnAttack4"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="3dp"
                        app:cardBackgroundColor="#16A34A"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvAtk4Name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="---"
                                android:textColor="@android:color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvAtk4Info"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#F1F5F9"
                                android:textSize="9.5sp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </GridLayout>

                <!-- Título Sección Equipo -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CAMBIAR POKÉMON"
                    android:textColor="#0284C7"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="4dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/boxTeamSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="4dp" />
                </HorizontalScrollView>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>