<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DC2626">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="6dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#CBD5E1">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F8FAFC"
            android:layout_margin="3dp">

            <!-- LÍNEA DIVISORIA: 55% Estadio, 45% Registro y Control -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideLineHorizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.55" />

            <!-- IMAGEN DE FONDO DEL ESTADIO POKÉMON (fondo.png) -->
            <ImageView
                android:id="@+id/imgBattleBackground"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                android:src="@drawable/fondo"
                android:contentDescription="Estadio Pokémon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/guideLineHorizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Botón Salir -->
            <ImageButton
                android:id="@+id/btnBackBattle"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@android:color/white"
                android:contentDescription="Regresar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Botón Repetir Combate Automático -->
            <Button
                android:id="@+id/btnReplayBattle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#16A34A"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Repetir Combate"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Info Rival -->
            <androidx.cardview.widget.CardView
                android:id="@+id/boxEnemyInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="10dp"
                app:cardElevation="3dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnBackBattle">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp">

                    <TextView
                        android:id="@+id/tvEnemyName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cargando..."
                        android:textColor="#0F172A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Popup de Daño Recibido Rival -->
                    <TextView
                        android:id="@+id/tvEnemyDamagePopup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/tvEnemyName"
                        android:layout_marginStart="8dp"
                        android:text="-0 HP"
                        android:textColor="#DC2626"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="invisible" />

                    <ProgressBar
                        android:id="@+id/pbEnemyHp"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="135dp"
                        android:layout_height="10dp"
                        android:layout_below="@id/tvEnemyName"
                        android:layout_marginTop="4dp"
                        android:max="100"
                        android:progress="100"
                        android:progressTint="#16A34A" />

                    <TextView
                        android:id="@+id/tvEnemyHpPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/pbEnemyHp"
                        android:layout_alignEnd="@id/pbEnemyHp"
                        android:text="100%"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Sprite Rival -->

            <!-- Sprite Jugador -->

            <ImageView
                android:id="@+id/imgEnemySprite"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_marginTop="84dp"
                android:layout_marginEnd="32dp"
                android:scaleType="fitCenter"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@android:drawable/ic_menu_gallery" />

            <ImageView
                android:id="@+id/imgPlayerSprite"
                android:layout_width="145dp"
                android:layout_height="145dp"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="10dp"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toTopOf="@id/boxBattleLog"
                app:layout_constraintStart_toStartOf="parent"
                tools:src="@android:drawable/ic_menu_gallery" />

            <!-- Info Jugador -->
            <androidx.cardview.widget.CardView
                android:id="@+id/boxPlayerInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="10dp"
                app:cardElevation="3dp"
                app:layout_constraintBottom_toTopOf="@id/boxBattleLog"
                app:layout_constraintEnd_toEndOf="parent">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp">

                    <TextView
                        android:id="@+id/tvPlayerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cargando..."
                        android:textColor="#0F172A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Popup de Daño Recibido Jugador -->
                    <TextView
                        android:id="@+id/tvPlayerDamagePopup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/tvPlayerName"
                        android:layout_marginStart="8dp"
                        android:text="-0 HP"
                        android:textColor="#DC2626"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="invisible" />

                    <ProgressBar
                        android:id="@+id/pbPlayerHp"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="145dp"
                        android:layout_height="10dp"
                        android:layout_below="@id/tvPlayerName"
                        android:layout_marginTop="4dp"
                        android:max="300"
                        android:progress="300"
                        android:progressTint="#16A34A" />

                    <TextView
                        android:id="@+id/tvPlayerHpExact"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/pbPlayerHp"
                        android:layout_alignEnd="@id/pbPlayerHp"
                        android:text="---/---"
                        android:textColor="#0284C7"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Banner Flotante de Ganador (Aparece al terminar la batalla) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardWinnerBanner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#0F172A"
                app:cardCornerRadius="14dp"
                app:cardElevation="8dp"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/guideLineHorizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/tvWinnerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¡VICTORIA!"
                        android:textColor="#FBBF24"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWinnerSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Ganador: Bulbasaur"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Banner Última Acción -->
            <androidx.cardview.widget.CardView
                android:id="@+id/boxBattleLog"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginBottom="6dp"
                app:cardBackgroundColor="#E0F2FE"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:layout_constraintBottom_toTopOf="@id/guideLineHorizontal">

                <TextView
                    android:id="@+id/tvBattleLog"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:text="Conectando con el estadio..."
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>

            <!-- Historial en vivo (45% Inferior) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:paddingHorizontal="10dp"
                android:paddingTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/guideLineHorizontal"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REGISTRO AUTOMÁTICO DE COMBATE"
                    android:textColor="#0284C7"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <ScrollView
                    android:id="@+id/scrollHistory"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#F8FAFC"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/tvLiveHistoryLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Iniciando simulación automática a Nivel 50...\n"
                        android:textColor="#334155"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />
                </ScrollView>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>